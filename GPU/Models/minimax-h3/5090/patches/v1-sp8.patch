+++ b/vllm_omni/diffusion/models/minimax_h3/v2_fp8_transport.py
@@ -0,0 +1,134 @@
+"""Fuse head-chunk layout conversion with per-head-vector FP8 transport."""
+
+import torch
+import triton
+import triton.language as tl
+
+_HEAD_DIM = 128
+_VECTOR_BYTES = _HEAD_DIM + 4
+_ROWS = 8
+
+
+@triton.jit
+def _encode(x, PACKED, vector, valid, channel, D: tl.constexpr):
+    amax = tl.maximum(tl.max(tl.abs(x), axis=1), 1.0e-10)
+    scale = amax / 448.0
+    codes = tl.clamp(x / scale[:, None], -448.0, 448.0).to(
+        tl.float8e4nv, fp_downcast_rounding="rtne",
+    ).to(tl.uint8, bitcast=True)
+    base = vector * (D + 4)
+    tl.store(PACKED + base[:, None] + channel[None, :], codes, valid[:, None])
+    exponent = scale.to(tl.uint32, bitcast=True)
+    for byte in tl.static_range(4):
+        tl.store(PACKED + base + D + byte, (exponent >> (byte * 8)).to(tl.uint8), valid)
+
+
+@triton.jit
+def _decode(PACKED, vector, valid, channel, ROWS: tl.constexpr, D: tl.constexpr):
+    base = vector * (D + 4)
+    code = tl.load(PACKED + base[:, None] + channel[None, :], valid[:, None], 0)
+    bits = tl.full((ROWS,), 0, tl.uint32)
+    for byte in tl.static_range(4):
+        bits = bits | (tl.load(PACKED + base + D + byte, valid, 0).to(tl.uint32) << (byte * 8))
+    scale = bits.to(tl.float32, bitcast=True)
+    value = code.to(tl.float8e4nv, bitcast=True).to(tl.float32) * scale[:, None]
+    return value
+
+
+@triton.jit
+def _pack(
+    Q, K, V, PACKED,
+    TOKENS: tl.constexpr, COUNT: tl.constexpr, OFFSET: tl.constexpr,
+    Q0: tl.constexpr, Q1: tl.constexpr, Q2: tl.constexpr,
+    K0: tl.constexpr, K1: tl.constexpr, K2: tl.constexpr,
+    V0: tl.constexpr, V1: tl.constexpr, V2: tl.constexpr,
+    ROWS: tl.constexpr, D: tl.constexpr,
+):
+    vector = tl.program_id(0) * ROWS + tl.arange(0, ROWS)
+    channel = tl.arange(0, D)
+    valid = vector < 8 * TOKENS * COUNT * 3
+    operand = vector % 3
+    head = vector // 3 % COUNT
+    token = vector // (3 * COUNT) % TOKENS
+    destination = vector // (3 * COUNT * TOKENS)
+    head = head + destination * 7 + OFFSET
+    q = tl.load(Q + (token * Q0 + head * Q1)[:, None] + channel[None, :] * Q2,
+                valid[:, None] & (operand[:, None] == 0), 0).to(tl.float32)
+    k = tl.load(K + (token * K0 + head * K1)[:, None] + channel[None, :] * K2,
+                valid[:, None] & (operand[:, None] == 1), 0).to(tl.float32)
+    v = tl.load(V + (token * V0 + head * V1)[:, None] + channel[None, :] * V2,
+                valid[:, None] & (operand[:, None] == 2), 0).to(tl.float32)
+    x = tl.where(operand[:, None] == 0, q, tl.where(operand[:, None] == 1, k, v))
+    _encode(x, PACKED, vector, valid, channel, D)
+
+
+@triton.jit
+def _unpack(PACKED, QKV, TOTAL: tl.constexpr, COUNT: tl.constexpr, ROWS: tl.constexpr, D: tl.constexpr):
+    vector = tl.program_id(0) * ROWS + tl.arange(0, ROWS)
+    channel = tl.arange(0, D)
+    valid = vector < TOTAL * COUNT * 3
+    value = _decode(PACKED, vector, valid, channel, ROWS, D)
+    operand = vector % 3
+    dst = (operand * TOTAL * COUNT + vector // 3) * D
+    tl.store(QKV + dst[:, None] + channel[None, :], value, valid[:, None])
+
+
+def pack(q, k, v, output, offset, count):
+    tokens, heads, dim = q.shape
+    assert (heads, dim) == (56, _HEAD_DIM)
+    vectors = 8 * tokens * count * 3
+    assert output.dtype == torch.uint8 and output.numel() == vectors * _VECTOR_BYTES
+    _pack[(triton.cdiv(vectors, _ROWS),)](
+        q, k, v, output, tokens, count, offset,
+        *q.stride(), *k.stride(), *v.stride(), _ROWS, _HEAD_DIM,
+    )
+
+
+def unpack(packed, qkv, total, count):
+    vectors = total * count * 3
+    assert packed.numel() == vectors * _VECTOR_BYTES
+    assert qkv.dtype == torch.bfloat16 and qkv.numel() == vectors * _HEAD_DIM
+    _unpack[(triton.cdiv(vectors, _ROWS),)](packed, qkv, total, count, _ROWS, _HEAD_DIM)
+
+
+
+@triton.jit
+def _pack_return(OUT, PACKED, VECTORS: tl.constexpr, ROWS: tl.constexpr, D: tl.constexpr):
+    vector = tl.program_id(0) * ROWS + tl.arange(0, ROWS)
+    channel = tl.arange(0, D)
+    valid = vector < VECTORS
+    value = tl.load(OUT + vector[:, None] * D + channel[None, :], valid[:, None], 0).to(tl.float32)
+    _encode(value, PACKED, vector, valid, channel, D)
+
+
+@triton.jit
+def _unpack_return(
+    PACKED, OUT,
+    TOKENS: tl.constexpr, COUNT: tl.constexpr, OFFSET: tl.constexpr,
+    ROWS: tl.constexpr, D: tl.constexpr,
+):
+    vector = tl.program_id(0) * ROWS + tl.arange(0, ROWS)
+    channel = tl.arange(0, D)
+    valid = vector < 8 * TOKENS * COUNT
+    value = _decode(PACKED, vector, valid, channel, ROWS, D)
+    head = vector % COUNT + OFFSET + (vector // (TOKENS * COUNT)) * 7
+    token = vector // COUNT % TOKENS
+    dst = token * 56 + head
+    tl.store(OUT + dst[:, None] * D + channel[None, :], value, valid[:, None])
+
+
+def pack_return(attended, output):
+    assert attended.is_contiguous()
+    vectors = attended.numel() // _HEAD_DIM
+    assert output.dtype == torch.uint8 and output.numel() == vectors * _VECTOR_BYTES
+    _pack_return[(triton.cdiv(vectors, _ROWS),)](attended, output, vectors, _ROWS, _HEAD_DIM)
+
+
+def unpack_return(packed, output, offset, count):
+    tokens, heads, dim = output.shape
+    assert (heads, dim) == (56, _HEAD_DIM) and output.is_contiguous()
+    vectors = tokens * 8 * count
+    assert packed.numel() == vectors * _VECTOR_BYTES
+    _unpack_return[(triton.cdiv(vectors, _ROWS),)](
+        packed, output, tokens, count, offset, _ROWS, _HEAD_DIM,
+    )
