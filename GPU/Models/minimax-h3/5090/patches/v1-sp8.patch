+"""Two training-free sparse attention candidates for one packed H3 request."""
+
+import math
+
+import torch
+from vllm_omni.diffusion.attention.ops.block_sparse import (
+    block_sparse_attn_bshd,
+    build_prefix_dense_block_map,
+    mean_pool_tiles,
+)
+
+
+def run_sparse(kind, q, k, v, out, prefix, trace=False, *, video_layout=None, prefix_segments=()):
+    if kind in ("h3vsa50", "h3vsa25"):
+        _run_h3_vsa(kind, q, k, v, out, prefix, trace, video_layout, prefix_segments)
+        return
+    if kind == "sparge50":
+        from spas_sage_attn import spas_sage2_attn_meansim_topk_cuda
+
+        value = spas_sage2_attn_meansim_topk_cuda(
+            *(t.transpose(0, 1).contiguous().unsqueeze(0) for t in (q, k, v)),
+            tensor_layout="HND", is_causal=False, scale=q.shape[-1] ** -0.5,
+            smooth_k=True, topk=0.5, pvthreshd=50, return_sparsity=trace,
+        )
+        if trace:
+            value, observed = value
+            print(f"H3_V2_SPARGE topk=0.5 qk_sparsity={float(observed):.6f}", flush=True)
+        out.copy_(value[0].transpose(0, 1))
+        return
+    if kind != "tiles50":
+        raise ValueError(f"unknown H3 sparse kind {kind}")
+    tokens = q.shape[0]
+    if prefix is None or not 0 < prefix < tokens:
+        raise ValueError("tile64 sparse attention needs a packed text/audio prefix")
+    blocks = math.ceil(tokens / 64)
+    prefix_blocks = math.ceil(prefix / 64)
+    tail = blocks - prefix_blocks
+    if tail < 2:
+        raise ValueError("tile64 sparse attention requires at least two video tiles")
+    keep = math.ceil(0.5 * tail)
+    sizes = (tokens - torch.arange(blocks, device=q.device, dtype=torch.int32) * 64).clamp(max=64)
+    pooled = [mean_pool_tiles(
+        torch.nn.functional.pad(t.unsqueeze(0), (0, 0, 0, 0, 0, blocks * 64 - tokens)),
+        sizes, 64,
+    ).bfloat16() for t in (q, k)]
+    scores = pooled[0] @ pooled[1].transpose(-1, -2)
+    block_map = build_prefix_dense_block_map(scores, prefix_blocks, tail, keep)
+    result = block_sparse_attn_bshd(
+        q.unsqueeze(0), k.unsqueeze(0), v.unsqueeze(0), block_map, sizes,
+        q.shape[-1] ** -0.5, provider="flashinfer", precision="sage",
+    )
+    out.copy_(result[0])
+    if trace:
+        selected = prefix_blocks * blocks + tail * (prefix_blocks + keep)
+        print(f"H3_V2_TILE64 prefix={prefix} qk_sparsity={1-selected/(blocks**2):.6f}", flush=True)
+
+
+def _run_h3_vsa(kind, q, k, v, out, prefix, trace, layout, prefix_segments):
+    from vllm_omni.diffusion.attention.backends.abstract import AttentionMetadata, VideoTokenLayout, VideoTokenSpan
+    from .attention.fastvideo_h3 import MiniMaxH3VSAImpl
+
+    if layout is None or prefix is None:
+        raise RuntimeError("H3 VSA needs packed video geometry")
+    target = next((span for span in reversed(layout.video_spans) if span.role == "target"), None)
+    if target is None and layout.latent_grid is not None:
+        target = VideoTokenSpan(prefix, layout.latent_grid, "target")
+    if target is None or target.start != prefix or target.start + target.length != q.shape[0]:
+        raise RuntimeError("Expected a single target video tail")
+    segments = prefix_segments or (prefix,)
+    shape = target.latent_grid
+    video_blocks = math.prod(math.ceil(n / 4) for n in shape)
+    keep = math.ceil(video_blocks * (0.50 if kind == "h3vsa50" else 0.25))
+    metadata = AttentionMetadata(
+        video_layout=VideoTokenLayout(used_len=q.shape[0], video_spans=(target,)),
+        extra={"vsa_h3_prefix_segments": segments},
+    )
+    impl = MiniMaxH3VSAImpl(
+        num_heads=q.shape[1], head_size=128, softmax_scale=128 ** -0.5,
+        backend_kwargs={"topk": keep, "provider": "flashinfer", "precision": "sage", "fallback_on_error": False},
+    )
+    # Ulysses already completed above. Reuse the native H3 kernel and tile routing directly.
+    result = impl._forward_h3(q[None], k[None], v[None], metadata, provider="flashinfer")
+    out.copy_(result[0])
+    if trace:
+        print(f"H3_V3_VSA kind={kind} video_grid={shape} keep={keep}/{video_blocks} prefix={segments}", flush=True)
