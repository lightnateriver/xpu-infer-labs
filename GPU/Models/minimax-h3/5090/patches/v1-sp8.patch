@@ -0,0 +1,173 @@
+"""Experimental SM120 dense attention with head-chunk Ulysses8."""
+
+import json
+import os
+
+import torch
+import torch.distributed as dist
+
+from flashinfer.diffusion_ops import minimax_h3_sm120_varlen_attention_nvfp4
+from vllm_omni.diffusion.distributed.parallel_state import get_sp_group
+
+SCHEDULE = (7,)
+FP8_TRANSPORT = False
+FP8_RETURN = False
+TRACE_AFTER = 0
+_COMM_STREAMS: dict[torch.device, torch.cuda.Stream] = {}
+_WORKSPACES: dict[tuple, tuple] = {}
+
+
+def configure(mode):
+    global SCHEDULE, TRACE_AFTER, FP8_TRANSPORT, FP8_RETURN
+    kind, _, flag = mode.partition(":")
+    modes = {"bf16": (7,), "nvfp4": (7,), "chunk43": (4, 3), "chunk322": (3, 2, 2), "chunk2221": (2, 2, 2, 1)}
+    fp8 = kind.startswith("fp8")
+    fp8_return = kind.endswith("rx")
+    schedule = modes[kind.removeprefix("fp8").removesuffix("rx")]
+    if schedule != SCHEDULE or fp8 != FP8_TRANSPORT or fp8_return != FP8_RETURN:
+        torch.cuda.synchronize()
+        _WORKSPACES.clear()
+    SCHEDULE = schedule
+    FP8_TRANSPORT = fp8
+    FP8_RETURN = fp8_return
+    TRACE_AFTER = 51 if flag == "trace" else 0
+    os.environ["H3_V2_CHECK_ADALN_TIMESTEPS"] = (
+        "1" if flag == "trace" and os.environ.get("H3_V2_ADALN_OWNER") == "1" else "0"
+    )
+    os.environ["H3_V2_NVFP4_ATTN"] = "0" if kind == "bf16" else "1"
+    if dist.get_rank() == 0:
+        print(f"H3_V2_MODE {kind} heads={SCHEDULE}", flush=True)
+
+
+def _staging(q, packed_total, slot, capacity):
+    key = q.device, q.dtype, packed_total, slot, capacity
+    buffers = _WORKSPACES.get(key)
+    if buffers is None:
+        _, _, dim = q.shape
+        n = packed_total * capacity * dim
+        if FP8_TRANSPORT:
+            payload_bytes = (3 * n // dim) * (dim + 4)
+            transfer = tuple(q.new_empty(payload_bytes, dtype=torch.uint8) for _ in range(2))
+        else:
+            transfer = tuple(q.new_empty(3 * n) for _ in range(2))
+        if FP8_RETURN:
+            return_bytes = (n // dim) * (dim + 4)
+            returns = tuple(q.new_empty(return_bytes, dtype=torch.uint8) for _ in range(2))
+        else:
+            returns = (q.new_empty(n),)
+        buffers = (*transfer, q.new_empty(3 * n), q.new_empty(n), returns)
+        _WORKSPACES[key] = buffers
+    return buffers
+
+
+def dense_nvfp4_ulysses(q, k, v, cu_seqlens, used, packed_total):
+    global TRACE_AFTER
+    group = get_sp_group().ulysses_group
+    world = dist.get_world_size(group)
+    tokens, heads, dim = q.shape
+    assert (world, heads, dim) == (8, 56, 128)
+    assert packed_total == world * tokens
+    local_heads = heads // world
+    assert sum(SCHEDULE) == local_heads
+    current = torch.cuda.current_stream(q.device)
+    comm = _COMM_STREAMS.get(q.device)
+    if comm is None:
+        comm = torch.cuda.Stream(device=q.device)
+        _COMM_STREAMS[q.device] = comm
+    trace = TRACE_AFTER == 1 and dist.get_rank() == 0
+    TRACE_AFTER = max(0, TRACE_AFTER - 1)
+    intervals = []
+
+    def stamp(stream):
+        if not trace:
+            return None
+        event = torch.cuda.Event(enable_timing=True)
+        event.record(stream)
+        return event
+
+    origin = stamp(current)
+    output = torch.empty_like(q, memory_format=torch.contiguous_format)
+    by_destination = output.view(tokens, world, local_heads, dim)
+    inputs = [tensor.reshape(tokens, world, local_heads, dim) for tensor in (q, k, v)]
+    lengths = cu_seqlens[:2]
+    capacities = tuple(max(SCHEDULE[i::2]) for i in range(min(2, len(SCHEDULE))))
+    slots = [_staging(q, packed_total, i, count) for i, count in enumerate(capacities)]
+
+    # The incoming projections and outgoing result belong to the compute
+    # stream. Bidirectional fences keep their storage live through comm use.
+    comm.wait_stream(current)
+
+    def exchange(i, offset, count):
+        send, receive, qkv, attended, returned = slots[i % 2]
+        n = packed_total * count * dim
+        with torch.cuda.stream(comm):
+            begin = stamp(comm)
+            if FP8_TRANSPORT:
+                from .v2_fp8_transport import pack
+
+                payload_bytes = (3 * n // dim) * (dim + 4)
+                send = send[:payload_bytes]
+                receive = receive[:payload_bytes]
+                pack(q, k, v, send, offset, count)
+            else:
+                send = send[:3 * n].view(world, tokens, count, 3, dim)
+                receive = receive[:3 * n].view_as(send)
+                for j, tensor in enumerate(inputs):
+                    send[..., j, :].copy_(tensor[:, :, offset:offset + count].transpose(0, 1))
+            dist.all_to_all_single(receive, send, group=group)
+            if trace:
+                intervals.append(("input", offset, begin, stamp(comm)))
+            ready = comm.record_event()
+        return receive, qkv[:3 * n], attended[:n], returned, ready
+
+    offset = 0
+    pending = exchange(0, 0, SCHEDULE[0])
+    for i, count in enumerate(SCHEDULE):
+        incoming, qkv, attended, returned, ready = pending
+        if i + 1 < len(SCHEDULE):
+            pending = exchange(i + 1, offset + count, SCHEDULE[i + 1])
+        current.wait_event(ready)
+        begin = stamp(current)
+        qkv = qkv.view(3, packed_total, count, dim)
+        if FP8_TRANSPORT:
+            from .v2_fp8_transport import unpack
+
+            unpack(incoming, qkv, packed_total, count)
+        else:
+            qkv.copy_(incoming.view(packed_total, count, 3, dim).permute(2, 0, 1, 3))
+        attended = attended.view(packed_total, count, dim)
+        attended[used:].zero_()
+        minimax_h3_sm120_varlen_attention_nvfp4(
+            qkv[0, :used], qkv[1, :used], qkv[2, :used],
+            lengths, out=attended[:used], cu_seqlens_host=[0, used],
+        )
+        if trace:
+            intervals.append(("compute", offset, begin, stamp(current)))
+        done = current.record_event()
+        with torch.cuda.stream(comm):
+            comm.wait_event(done)
+            begin = stamp(comm)
+            if FP8_RETURN:
+                from .v2_fp8_transport import pack_return, unpack_return
+
+                return_bytes = packed_total * count * (dim + 4)
+                return_send, return_recv = (buffer[:return_bytes] for buffer in returned)
+                pack_return(attended, return_send)
+                dist.all_to_all_single(return_recv, return_send, group=group)
+                unpack_return(return_recv, output, offset, count)
+            else:
+                returned = returned[0][:packed_total * count * dim].view(world, tokens, count, dim)
+                dist.all_to_all_single(returned, attended.view_as(returned), group=group)
+                by_destination[:, :, offset:offset + count].copy_(returned.transpose(0, 1))
+            if trace:
+                intervals.append(("output", offset, begin, stamp(comm)))
+        offset += count
+    current.wait_stream(comm)
+    if trace:
+        current.synchronize()
+        print("H3_V2_TRACE " + json.dumps({
+            "tokens": used, "heads": SCHEDULE,
+            "intervals_ms": [[kind, offset, origin.elapsed_time(a), origin.elapsed_time(b)]
+                             for kind, offset, a, b in intervals],
+        }), flush=True)
+    return output
